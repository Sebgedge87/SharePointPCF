<?xml version="1.0" encoding="utf-8"?>
<!-- For the XrmToolBox Tool Library: nuget pack DataModelExplorer.XrmToolBox.nuspec, then push the .nupkg to nuget.org.
     Fill in projectUrl and iconUrl (public addresses) before publishing. -->
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>FormusPro.DataModelExplorer</id>
    <version>5.0.4</version>
    <title>Data Model Explorer</title>
    <authors>FormusPro</authors>
    <owners>FormusPro</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Open a Dataverse data-model workbook, check it, draw the ERD and build an unmanaged solution from it. Load a solution from the connected environment as the model, or check a workbook against the environment for undocumented and unmanaged changes. Reads the environment only.</description>
    <summary>View, check and build Dataverse data models, and compare them with the connected environment.</summary>
    <releaseNotes>5.0.4: shows its version, saves table details on sheets with none, offers Save as when the original file has gone</releaseNotes>
    <tags>XrmToolBox Plugins DataModel ERD Solution Metadata</tags>
    <projectUrl>https://example.com/replace-me</projectUrl>
    <iconUrl>https://example.com/replace-me.png</iconUrl>
    <dependencies>
      <dependency id="XrmToolBox" version="1.2025.10.74" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\FormusPro.DataModelExplorer.XrmToolBox.dll" target="lib\net48\Plugins\" />
  </files>
</package>
